# ============================================================
# OBILeadLagCollector Environment Configuration (Example)
# Copy to .env and configure before starting locally or on Render
# ============================================================

# MongoDB Atlas Free (M0) Connection URI
MONGO_DB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/obi_lead_lag?retryWrites=true&w=majority

# Web Service Port (Render sets this automatically via $PORT)
PORT=8080

# Environment: 'production' or 'development'
ENVIRONMENT=production

# Logging Level: INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO

# Sync Interval to MongoDB Atlas in seconds (default: 600 = 10 minutes)
FLUSH_INTERVAL_SEC=600

# Minimum basis points divergence to record a Lead-Lag dislocation event (e.g. 15.0 bps = 0.15%)
MIN_LEAD_LAG_BPS=15.0

# OBI Threshold for Binance Lead (0.50 = 75/25 book ratio, 0.60 = 80/20 book ratio)
OBI_THRESHOLD=0.50
